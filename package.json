{
  "name": "cc-start",
  "version": "0.2.0",
  "private": true,
  "description": "Multi-model launcher for Claude Code",
  "type": "commonjs",
  "bin": {
    "cc-start": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
